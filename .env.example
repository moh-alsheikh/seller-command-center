# Copy to .env and fill in. .env is git-ignored.

# The only API key this project needs. Read directly by the Claude Agent SDK.
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults live in src/scc/config.py) ---------------------------------
# SCC_HUB_MODEL=claude-sonnet-5-5
# SCC_ANALYST_MODEL=claude-sonnet-5-5
# SCC_SPOKE_MODEL=claude-haiku-5-5
# SCC_MAX_TURNS=30
# SCC_MAX_BUDGET_USD=1.00
# SCC_APPROVAL_TIMEOUT_S=300
# SCC_DATA_DIR=./data

# --- Optional login for the Chainlit UI (both must be set to enable it) ----------------------
# SCC_APP_USER=seller
# SCC_APP_PASSWORD=change-me
# Chainlit needs this secret to sign login sessions. Generate it with: uv run chainlit create-secret
# CHAINLIT_AUTH_SECRET=

# --- Optional token for the read-only JSON API (/api/...) ------------------------------------
# SCC_API_TOKEN=change-me
