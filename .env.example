# Copy to .env and fill in. .env is git-ignored.

# The only API key this project needs. Read directly by the Claude Agent SDK.
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults live in src/scc/config.py) ---------------------------------
# SCC_HUB_MODEL=claude-sonnet-5-5
# SCC_ANALYST_MODEL=claude-sonnet-5-5
# SCC_SPOKE_MODEL=claude-haiku-5-5
# SCC_MAX_TURNS=30
# SCC_MAX_BUDGET_USD=1.00
# SCC_APPROVAL_TIMEOUT_S=300
# SCC_DATA_DIR=./data

# --- Login + chat history for the web UI ---------------------------------------------------
# With both set, the UI asks for a login and keeps every chat (sidebar history, reopen and
# continue). Remove both lines for an anonymous UI without history.
# DEMO VALUES: change the password before the app is reachable by anyone else.
SCC_APP_USER=seller
SCC_APP_PASSWORD=seller-demo
# The secret that signs login cookies is generated on first start and kept in
# data/.chainlit_auth_secret. Set it yourself only to share it between several servers:
# CHAINLIT_AUTH_SECRET=

# --- Optional token for the read-only JSON API (/api/...) ------------------------------------
# SCC_API_TOKEN=change-me
